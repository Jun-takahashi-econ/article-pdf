{
  "manifest_version": 3,
  "name": "Article PDF",
  "version": "0.2.0",
  "description": "開いている記事の本文だけを抜き出して、テキスト付きのPDFに保存します。",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "この記事をPDFに保存",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "debugger",
    "downloads",
    "nativeMessaging"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "この記事をPDFに保存"
    }
  }
}
